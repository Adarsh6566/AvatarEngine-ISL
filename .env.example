# Universal config is config.yaml at repo root. Env vars below override it.
# See config.yaml for all tunable values (ports, CORS, validation, animation).

# Frontend — Vite env (must be prefixed VITE_)
# Absolute backend URL. If set, frontend calls it directly.
# If empty/unset, frontend uses /api/* which Vite proxies to the backend in dev.
VITE_API_URL=http://127.0.0.1:8000

# Backend — CORS
# Comma-separated origins allowed to call the API. Must match the Vite dev server origin(s).
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides for config.yaml
# BACKEND_PORT=8000
# BACKEND_HOST=127.0.0.1
# DICTIONARY_PATH=backend/vocabulary.json
# LOG_LEVEL=INFO
